# ─── Vertex local development ────────────────────────────────────────────────

# Postgres + Redis are provided by docker-compose.yml. Copy to .env and adjust.

# Engine (Rust)
ENGINE_PORT=5000
WAL_ENABLED=false
WAL_PATH=engine.wal
RUST_LOG=info,engine=debug

# Shared
REDIS_URL=redis://localhost:6379

# API gateway (Go)
GATEWAY_PORT=8080
ENGINE_GRPC_ADDR=0.0.0.0:5000
DATABASE_URL=postgres://vertex:vertex@localhost:5432/vertex?sslmode=disable
JWT_SECRET=change-me-in-production
JWT_TTL=24h
