# ─── Vertex local development ────────────────────────────────────────────────

# Postgres + Redis are provided by docker-compose.yml. Copy to .env and adjust.

# Engine (Rust) — PORT is the engine's own gRPC listen port.
PORT=5000
WAL_ENABLED=false
WAL_PATH=engine.wal
RUST_LOG=info,engine=debug

# Shared
REDIS_URL=redis://localhost:6379

# API gateway (Go) — ENGINE_GRPC_ADDR is the address the gateway dials to
# reach the engine above.
GATEWAY_PORT=8080
ENGINE_GRPC_ADDR=localhost:5000
DATABASE_URL=postgres://vertex:vertex@localhost:5432/vertex?sslmode=disable
DB_MAX_CONNS=20
JWT_SECRET=dev-secret-change-me
JWT_TTL=24h
